{
  "_comment": "High-precision routing. Statistical matching is too weak on the 80-character summaries news feeds return, so these phrases carry the work. 'any' fires the rule; 'all' must also be satisfied where present. Add phrases as you publish.",

  "rules": [
    {
      "slug": "dispatch-check-and-the-ceiling",
      "any": ["dividend check", "$5,000 check", "5000 check", "rebate check", "tariff rebate",
              "tariff dividend", "stimulus check", "doge dividend", "checks for americans",
              "$2,000 check", "2000 check"]
    },
    {
      "slug": "dispatch-tariff-trap",
      "any": ["tariff", "customs duties", "import duties", "trade war"],
      "not": ["tariff rebate", "tariff dividend"]
    },
    {
      "slug": "dispatch-dark-fiber-power-bill",
      "any": ["data center", "data centre", "ai buildout", "compute capacity", "server farm"]
    },
    {
      "slug": "datacenter-neighborhood",
